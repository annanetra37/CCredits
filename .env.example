# ---------------------------------------------------------------------------
# CCredits configuration. Copy to .env for local work.
# On Railway, set these as service variables instead — see docs/ENVIRONMENT.md.
# Every value below is a default; the app runs with none of them set.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Railway's Postgres plugin provides this. Locally, point it at your own.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ccredits
# Railway injects PORT itself — do not set it there.
PORT=8000
APP_ENV=local
LOG_LEVEL=info
# Apply the schema on startup. Leave on: the schema is idempotent.
AUTO_MIGRATE=true

# --- Upload and storage ----------------------------------------------------
# local writes to STORAGE_DIR; s3 writes to a bucket.
# Railway's filesystem is ephemeral, so use s3 there if uploads must survive.
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
UPLOAD_MAX_MB=50
# Only read when STORAGE_BACKEND=s3. Works with any S3-compatible service.
S3_BUCKET=
S3_PREFIX=uploads
S3_ENDPOINT_URL=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Access ----------------------------------------------------------------
# Empty means anyone with the URL can upload. Set it to require a token.
ADMIN_TOKEN=

# --- Stated assumptions ----------------------------------------------------
# These decide the headline number and are shown on screen as assumptions.
# Daily specific yield above this is flagged suspect (kWh per kWp per day).
IMPLAUSIBLE_KWH_PER_KWP=8.0
# suspect = a zero-generation day is flagged; ok = zero is treated as normal.
ZERO_DAY_POLICY=suspect
# exclude = a missing day is a gap; zero = it counts as a covered zero day.
MISSING_DAY_POLICY=exclude
TRUST_GRID_CONNECTION_DATE=true

# --- Reference data seeds --------------------------------------------------
# Only used to seed empty reference tables on first run. After that, edit the
# rows in gold.emission_factor and gold.price — they are versioned there.
# NOT SET BY DEFAULT, on purpose. There is no agreed Armenian grid emission
# factor in this project yet. Until you set one, the portal reports carbon and
# carbon revenue as zero and says so on screen — it will not substitute a guess.
# When you set it, name the document it came from in the same breath.
DEFAULT_EMISSION_FACTOR=
DEFAULT_EMISSION_FACTOR_SOURCE=
DEFAULT_EMISSION_FACTOR_URL=
DEFAULT_EMISSION_FACTOR_VINTAGE=
DEFAULT_IREC_PRICE_PER_MWH=1.50
DEFAULT_VCU_PRICE_PER_TCO2E=8.00
PRICE_CURRENCY=USD

# --- Presentation ----------------------------------------------------------
BANNER_TEXT=Pilot data. Not verified.
FLEET_NAME=SANNOVA
