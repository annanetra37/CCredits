# ---------------------------------------------------------------------------
# CCredits configuration. Copy to .env for local work.
# In Azure, set these as Container App secrets/env vars — see docs/DEPLOY_AZURE.md.
# Every value below is a default; the app runs with none of them set.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Azure Database for PostgreSQL requires TLS:
#   postgresql://USER:PASS@HOST.postgres.database.azure.com:5432/ccredits?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ccredits
# The host injects PORT. On Azure App Service also set WEBSITES_PORT to match.
PORT=8000
APP_ENV=local
LOG_LEVEL=info
# Apply the schema on startup. Leave on: the schema is idempotent.
AUTO_MIGRATE=true

# --- Upload and storage ----------------------------------------------------
# local | azure | s3.  A container filesystem is ephemeral, so any deployment
# that must keep its uploaded originals needs azure (or s3).
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
UPLOAD_MAX_MB=50
# --- Azure Blob Storage (STORAGE_BACKEND=azure) ----------------------------
# Either give a connection string, OR give only the account name and let the
# app's managed identity authenticate — that way no storage secret is stored
# in configuration at all. Grant the identity "Storage Blob Data Contributor".
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=uploads
AZURE_STORAGE_CONNECTION_STRING=

# Only read when STORAGE_BACKEND=s3. Works with any S3-compatible service.
S3_BUCKET=
S3_PREFIX=uploads
S3_ENDPOINT_URL=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Access ----------------------------------------------------------------
# Empty means anyone with the URL can upload. Set it to require a token.
ADMIN_TOKEN=

# --- Stated assumptions ----------------------------------------------------
# These decide the headline number and are shown on screen as assumptions.
# Daily specific yield above this is flagged suspect (kWh per kWp per day).
IMPLAUSIBLE_KWH_PER_KWP=8.0
# suspect = a zero-generation day is flagged; ok = zero is treated as normal.
ZERO_DAY_POLICY=suspect
# exclude = a missing day is a gap; zero = it counts as a covered zero day.
MISSING_DAY_POLICY=exclude
TRUST_GRID_CONNECTION_DATE=true

# --- Emission factor -------------------------------------------------------
# Leave these EMPTY and the app seeds Table 1 of CDM Standardized Baseline
# ASB0038-2018 (Armenia, 2016 vintage) — all five published margins, with the
# wind-and-solar combined margin of 0.4329 tCO2e/MWh marked as the one applied.
# Set them only to override that with a different published factor.
DEFAULT_EMISSION_FACTOR=
DEFAULT_EMISSION_FACTOR_SOURCE=
DEFAULT_EMISSION_FACTOR_URL=
DEFAULT_EMISSION_FACTOR_VINTAGE=

# ASB0038-2018 states its own validity ends 2021-02-18. It is the most recent
# approved baseline for Armenia, so it is applied to later months too; the
# portal shows both dates so the difference is never hidden.
EMISSION_FACTOR_VALID_FROM=
# The published Armenian table is recorded as checked against the source
# document the fleet owner supplied. Set this to record WHO checked it, which
# is what an audit trail wants; the check itself does not depend on it.
EMISSION_FACTOR_VERIFIED_BY=

# --- VCU price -------------------------------------------------------------
# Conservative end of the VCU range. Affects the revenue figure only, never
# the number of credits. Set VCU_PRICE_SOURCE to the quote it came from.
DEFAULT_VCU_PRICE_PER_TCO2E=3.00
VCU_PRICE_SOURCE=
PRICE_CURRENCY=USD

# --- Presentation ----------------------------------------------------------
BANNER_TEXT=Pilot data. Not verified.
FLEET_NAME=SANNOVA
# Sites are shown by a stable code (SITE-A7D7DC) rather than the client name.
# Set true only for an internal audience that should see real names.
SHOW_REAL_SITE_NAMES=false
